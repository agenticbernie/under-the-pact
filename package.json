{
  "name": "pact-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @pact/api dev\" \"pnpm --filter @pact/web dev\"",
    "predev": "pnpm --filter @pact/shared build",
    "dev:api": "pnpm --filter @pact/api dev",
    "dev:web": "pnpm --filter @pact/web dev",
    "build": "pnpm --filter @pact/shared build && pnpm --filter @pact/api build && pnpm --filter @pact/web build",
    "test": "pnpm --recursive test",
    "pretest": "pnpm --filter @pact/shared build",
    "deploy:api": "pnpm --filter @pact/shared build && neon deploy",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "check:no-secrets": "bash scripts/check-no-secrets.sh"
  },
  "devDependencies": {
    "@neon/config": "^1.7.2",
    "concurrently": "^9.1.2",
    "neon": "^5.0.0",
    "typescript": "^5.7.3"
  }
}
