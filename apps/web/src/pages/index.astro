---
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8787";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pact — Confirmation-first USDC payments (PoC)</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 720px; margin: 48px auto; padding: 0 20px; line-height: 1.6; }
      .card { border: 1px solid #ddd; border-radius: 12px; padding: 20px; margin: 16px 0; }
      code { background: #f4f4f4; padding: 2px 6px; border-radius: 6px; }
      #health { font-weight: 600; }
      textarea { width: 100%; min-height: 84px; font: inherit; padding: 10px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; }
      button { font: inherit; padding: 8px 20px; border-radius: 8px; border: 1px solid #333; background: #111; color: #fff; cursor: pointer; }
      button:disabled { opacity: 0.5; cursor: wait; }
      #req-error { color: #a00; min-height: 1.5em; }
      #req-status { min-height: 1.5em; }
      .hint { color: #666; font-size: 0.9em; }
    </style>
  </head>
  <body>
    <h1>Pact PoC — payment request</h1>
    <p>
      Confirmation-first AI payment agent for controlled USDC payments on Solana.
      Describe the payment below. Nothing here creates a transaction (Sprint Gate).
    </p>
    <div class="card">
      <h3>1. Payment request (BER-130)</h3>
      <form id="req-form">
        <textarea
          id="req-text"
          maxlength="2000"
          placeholder="e.g. Pay 5 USDC to Pact Coffee for oat latte"
        ></textarea>
        <div class="hint"><span id="req-count">0</span>/2000 — parsed by the AI agent, validated later.</div>
        <p><button type="submit" id="req-submit">Submit request</button></p>
      </form>
      <div id="req-error" role="alert"></div>
      <div id="req-status" aria-live="polite"></div>
    </div>
    <div class="card">
      <div>Backend: <code id="api-url">{apiUrl}</code></div>
      <div>Health: <span id="health">checking…</span></div>
      <pre id="health-raw"></pre>
    </div>
    <div class="card">
      <h3>Trust boundary (PRD §9)</h3>
      <p>AI proposes → deterministic code validates → user confirms → wallet signs → Solana verifies.</p>
    </div>
    <script>
      import { validateRequestText } from "../lib/request.js";

      const apiUrl = document.getElementById("api-url")?.textContent ?? "http://localhost:8787";
      const form = document.getElementById("req-form") as HTMLFormElement;
      const input = document.getElementById("req-text") as HTMLTextAreaElement;
      const error = document.getElementById("req-error") as HTMLDivElement;
      const status = document.getElementById("req-status") as HTMLDivElement;
      const count = document.getElementById("req-count") as HTMLSpanElement;
      const submit = document.getElementById("req-submit") as HTMLButtonElement;

      input.addEventListener("input", () => {
        count.textContent = String(input.value.length);
        error.textContent = "";
        // Stale responses must never linger under edited text (Codex P2):
        // any keystroke invalidates the previous round-trip display.
        if (!input.disabled) {
          status.textContent = "";
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        error.textContent = "";
        status.textContent = "";
        const checked = validateRequestText(input.value);
        if (!checked.ok) {
          error.textContent = checked.error;
          return;
        }
        submit.disabled = true;
        // Lock the text during the round trip so a late response can never
        // land under edited input (Codex P2). Tag it with the submitted
        // value and only render if the text is unchanged.
        input.disabled = true;
        const sentText = checked.text;
        status.textContent = "Sending to intent parser…";
        try {
          const res = await fetch(`${apiUrl}/api/intent/parse`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ text: checked.text })
          });
          const body = (await res.json()) as {
            ok: boolean;
            code?: string;
            message?: string;
            missing?: string[];
            intent?: {
              intentId: string;
              status: string;
              merchantId: string;
              amountMicroUsdc: number;
              expiry: string;
            };
          };
          if (input.value.trim() !== sentText) {
            // Text changed mid-flight (shouldn't happen while disabled,
            // but never render a response for text the user didn't send).
            status.textContent = "";
          } else if (res.ok && body.intent) {
            const usdc = body.intent.amountMicroUsdc / 1_000_000;
            status.textContent =
              `Parsed: ${usdc} USDC to ${body.intent.merchantId} ` +
              `(intent ${body.intent.intentId.slice(0, 15)}…). Validating…`;
            // BER-134/135: run deterministic validation on the parsed intent.
            // One-line verdict only — the full summary view lands in BER-136.
            const vres = await fetch(`${apiUrl}/api/intent/validate`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ intent: body.intent })
            });
            const verdict = (await vres.json()) as {
              ok: boolean;
              code?: string;
              message?: string;
              intent?: { status: string };
            };
            if (vres.ok && verdict.intent) {
              status.textContent += ` Validated (${verdict.intent.status}).`;
            } else {
              status.textContent += ` Rejected: ${verdict.code || vres.status}.`;
            }
          } else if (res.status === 422 && body.code === "AMBIGUOUS_REQUEST") {
            error.textContent = body.message || "Need a bit more detail.";
            if (body.missing?.length) {
              error.textContent += ` (missing: ${body.missing.join(", ")})`;
            }
            status.textContent = "";
          } else if (!res.ok) {
            error.textContent = body.message || `Request rejected (${body.code || res.status}).`;
            status.textContent = "";
          } else {
            status.textContent = JSON.stringify(body);
          }
        } catch (err) {
          error.textContent = "Backend not reachable — start pnpm dev:api.";
          status.textContent = "";
        } finally {
          submit.disabled = false;
          input.disabled = false;
        }
      });
    </script>
    <script define:vars={{ apiUrl }}>
      fetch(`${apiUrl}/api/health`)
        .then((r) => r.json())
        .then((j) => {
          document.getElementById("health").textContent = j.ok ? `ok (${j.network})` : "not ok";
          document.getElementById("health-raw").textContent = JSON.stringify(j, null, 2);
        })
        .catch((e) => {
          document.getElementById("health").textContent = "backend not reachable — start pnpm dev:api";
          document.getElementById("health-raw").textContent = String(e);
        });
    </script>
  </body>
</html>
