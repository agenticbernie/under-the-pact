# Pact — env template (copy to .env / .env.local, never commit real values)
# Solana network: devnet for PoC (PRD §11, REQ-F-006)
SOLANA_NETWORK=devnet
# Public RPC for devnet (used by preflight/tx builder in Sprint 2)
SOLANA_RPC_URL=https://api.devnet.solana.com

# USDC mint on devnet — overwritten with real test mint before demo
# Mainnet USDC reference: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=4zMMC9sEqf9MKyRbf3Tx3sQAr1BLWnCQcHjEXtGbm4o

# Pre-registered merchant (BER-133, REQ-F-005/009, REQ-S-007)
# MERCHANT_WALLET is REQUIRED and pubkey-validated at boot.
# Dummy below is the system program address (valid format only) so the
# skeleton boots. Replace with the real devnet recipient before the demo;
# BER-133 locks the final value.
MERCHANT_ID=pact-coffee-demo
MERCHANT_DISPLAY_NAME=Pact Coffee Demo
MERCHANT_WALLET=11111111111111111111111111111111
SPENDING_LIMIT_USDC=50

# Neon Postgres — injected automatically on Neon Functions deploy.
# Locally: point to a Neon branch (pooled) or leave placeholder; /health works without DB.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/pact?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/pact?sslmode=require

# Backend
API_PORT=8787
# Frontend (Astro) calls this URL client-side
PUBLIC_API_URL=http://localhost:8787

# Intent parser LLM (BER-132, OpenAI-compatible chat API, JSON mode).
# Works with OpenAI, Neon AI Gateway, or any compatible endpoint / local model.
# LLM_API_KEY is REQUIRED for live parsing and must never be committed
# (REQ-S-008). Missing key fails requests with PARSER_ERROR, never silently.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Payment-intent time-to-live after parsing (seconds)
INTENT_TTL_SECONDS=900
